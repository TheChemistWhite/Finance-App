# ---- Server ----
PORT=8787
NODE_ENV=development

# Comma-separated list of origins allowed to call this API.
# In production this MUST be your app's real origin(s) only.
CORS_ORIGINS=http://localhost:5173,capacitor://localhost,http://localhost

# ---- Secrets (generate your own, never commit real values) ----
# 32-byte (64 hex chars) key used to encrypt provider access tokens at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARS

# Used to sign session JWTs issued after a successful biometric login.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET

# ---- WebAuthn (biometric login) ----
# Must match the domain the app is served from. "localhost" for local dev.
RP_ID=localhost
RP_NAME=Vibrant Wallet
# Full origin (scheme+host+port) the browser/app will call from.
ORIGIN=http://localhost:5173

# ---- Bank data provider ----
# "mock" works with zero setup and simulates a real aggregator end-to-end.
# Switch to "plaid" (or write a truelayer/tink provider) once you have
# real API credentials from that provider — see server/README.md.
BANK_PROVIDER=mock

# Only needed once BANK_PROVIDER=plaid (https://dashboard.plaid.com)
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox
